{
  "$schema": "https://raw.githubusercontent.com/CrosswiredStudios/CSweetAgentSdk/main/schemas/csweet-plugin.v2.schema.json",
  "manifestVersion": "2.0",
  "kind": "agent",
  "rolePolicy": {
    "profile": "individual-contributor.v1",
    "declaredRoleKeys": ["game-build-release-engineer"],
    "specializationKeys": ["video-game-development", "build-release-engineering", "build-diagnostics"]
  },
  "id": "com.csweet.video-game-build-release-engineer",
  "name": "Avery Coleman",
  "version": "2.1.1",
  "publisher": { "id": "com.csweet", "name": "C-Sweet" },
  "runtime": {
    "type": "dotnet-project",
    "projectPath": "src/CSweet.Agent.BuildReleaseEngineer.VideoGame/CSweet.Agent.BuildReleaseEngineer.VideoGame.csproj",
    "targetFramework": "net10.0",
    "defaultActivationMode": "OnDemand",
    "defaultTickFrequencySeconds": 300,
    "supportsMultipleInstallations": true,
    "maximumConcurrentJobs": 1
  },
  "protocol": { "minimumVersion": "2.0", "maximumVersion": "2.x" },
  "provides": [
    {
      "name": "work.execution.run.v1",
      "description": "Owns build configuration, adapter operations, packaging, release-readiness evidence, and publication proposals.",
      "inputSchema": {
        "type": "object",
        "required": ["sprintExecutionId", "itemExecutionId", "stageExecutionId", "attemptId", "organizationId", "boardId", "sprintId", "itemId", "assignmentRevision", "boardKey", "itemIdentifier", "policyRevisionId", "stageKey", "traversal", "attempt", "deadline", "instructions", "item", "input", "priorOutcomes", "evidence"],
        "properties": {},
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        },
        "required": [],
        "additionalProperties": true
      },
      "executionTimeoutSeconds": 30,
      "idempotency": "work-item",
      "riskClass": "standard"
    },
    {
      "name": "agent.configuration.describe.v1",
      "description": "Describe specialist configuration.",
      "inputSchema": { "type": "object", "additionalProperties": true },
      "outputSchema": { "type": "object", "additionalProperties": true },
      "executionTimeoutSeconds": 30,
      "idempotency": "none",
      "riskClass": "standard"
    },
    {
      "name": "agent.configuration.update.v1",
      "description": "Update specialist configuration.",
      "inputSchema": { "type": "object", "additionalProperties": true },
      "outputSchema": { "type": "object", "additionalProperties": true },
      "executionTimeoutSeconds": 30,
      "idempotency": "work-item",
      "riskClass": "standard"
    }
  ],
  "requires": [
    { "name": "platform.llm.chat-stream.v1", "scope": "organization", "purpose": "Produce grounded role-owned deliverables from exact project evidence." },
    { "name": "work.item.read", "scope": "organization", "purpose": "Read only the authoritative assigned board item." },
    { "name": "work.item.comment", "scope": "organization", "purpose": "Record progress, blockers, findings, and evidence on the authoritative item." },
    { "name": "platform.artifact.read.v1", "scope": "organization", "purpose": "Read authorized exact document revisions and hashes." },
    { "name": "platform.artifact.create.v1", "scope": "organization", "purpose": "Create the role-owned durable deliverable." },
    { "name": "platform.artifact.submit.v1", "scope": "organization", "purpose": "Submit the exact deliverable revision for accountable review." },
    { "name": "communication.coordination.read.v1", "scope": "team", "purpose": "Read planning and estimation coordination." },
    { "name": "communication.coordination.respond.v1", "scope": "team", "purpose": "Respond with role-owned planning, estimation, or review evidence." },
    { "name": "platform.agent-operating-state.read.v1", "scope": "organization", "purpose": "Recover project/work-item state and duplicate-delivery outcomes after restart." },
    { "name": "platform.agent-operating-state.write.v1", "scope": "organization", "purpose": "Persist revision-safe state isolated by Workstream and authoritative work item." }
  ],
  "events": { "subscribes": ["com.csweet.agent.coordination.turn-requested.v1"] },
  "configuration": [
    { "key": "llmProviderId", "type": "provider", "label": "LLM provider", "required": true, "secret": false },
    { "key": "llmModel", "type": "model", "label": "Model", "required": true, "secret": false, "dependsOnFieldKey": "llmProviderId" }
  ],
  "credentials": [],
  "webAccess": { "mode": "None", "rules": [] },
  "ui": [],
  "catalog": {
    "imageUrl": "https://raw.githubusercontent.com/CrosswiredStudios/CSweet.Agent.BuildReleaseEngineer.VideoGame/main/assets/branding/portrait-v1.jpg",
    "companyLogoUrl": "https://raw.githubusercontent.com/CrosswiredStudios/CSweet.Agent.BuildReleaseEngineer.VideoGame/main/assets/branding/csweet-icon.svg",
    "accentColor": "#426250",
    "summary": "Owns build configuration, adapter operations, packaging, release-readiness evidence, and publication proposals.",
    "category": "Engineering",
    "role": { "key": "game-build-release-engineer", "name": "Video Game Build Release Engineer" },
    "license": { "spdxId": "MIT" },
    "iconUrls": [],
    "roleAliases": [],
    "keywords": [],
    "documentationUrl": "README.md"
  }
}
